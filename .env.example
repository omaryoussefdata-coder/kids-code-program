# رابط الاتصال بقاعدة بيانات Postgres (Supabase - استخدم Session Pooler عشان يشتغل على Replit)
# ممكن تستخدم نفس قاعدة بيانات مشروع Code Academy وتزود عليها الجداول دي، أو تعمل مشروع Supabase جديد.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# سر تشفير الجلسة (session) - أي نص عشوائي طويل
SESSION_SECRET=change-this-to-a-random-long-string

# بيانات حساب الأدمن الوحيد اللي بيتعمل تلقائي أول ما السيرفر يشتغل
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# اسم البرنامج والوصف المختصر (تقدر تغيرهم من صفحة الإعدادات في لوحة الأدمن بعد كده)
PROGRAM_NAME=برنامج البرمجة للأطفال

PORT=3000
NODE_ENV=production
